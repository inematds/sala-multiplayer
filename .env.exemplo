# Copie para .env (o .env fica fora do git). Nunca cole o token em chat nem em commit.
# Token do bot criado no @BotFather. Sem ele a sala funciona só pelo painel.
SALA_TELEGRAM_TOKEN=
# Seu id numérico no Telegram (descubra com o @userinfobot). Perfil "pessoa": só ele fala com o bot.
SALA_DONO_TELEGRAM_ID=
# Perfil "atendimento": ids da equipe (recebem aviso de aprovação e podem usar /aprovar N e /recusar N).
SALA_SUPERVISOR_TELEGRAM_ID=
SALA_ATENDENTE_TELEGRAM_ID=
# Opcional: porta e endereço do painel (padrão 127.0.0.1:4600, só nesta máquina).
# SALA_PORTA=4600
# SALA_HOST=127.0.0.1
# Opcional: forçar modelo (padrão: nível EXECUTOR de ~/.config/inema/modelos.env, ou o padrão do CLI).
# SALA_MODELO_CLAUDE=
# SALA_MODELO_CODEX=
