# Copie para .env (o .env fica fora do git). Nunca cole o token em chat nem em commit.
# Token do bot criado no @BotFather. Sem ele a sala funciona só pelo painel.
SALA_TELEGRAM_TOKEN=
# Seu id numérico no Telegram (descubra com o @userinfobot). Perfil "pessoa": só ele fala com o bot.
SALA_DONO_TELEGRAM_ID=
# Perfil "atendimento": ids da equipe (recebem aviso de aprovação e podem usar /aprovar N e /recusar N).
# Perfil "pessoa": outra pessoa da equipe (ex.: Tiza). Quem não sabe o id manda "ping" ao bot e recebe de volta.
SALA_TIZA_TELEGRAM_ID=
SALA_SUPERVISOR_TELEGRAM_ID=
SALA_ATENDENTE_TELEGRAM_ID=
# Senha do dono para mudar a configuração (limites, modelos) pela tela /config e aprovar mudanças pedidas no chat.
# Vazia = pelo painel nada muda (só pelo /config do Telegram, a partir do id do dono).
SALA_DONO_SENHA=
# Opcional: porta e endereço do painel (padrão 127.0.0.1:4600, só nesta máquina).
# SALA_PORTA=4600
# SALA_HOST=127.0.0.1
# Opcional: forçar modelo (padrão: nível EXECUTOR de ~/.config/inema/modelos.env, ou o padrão do CLI).
# SALA_MODELO_CLAUDE=
# SALA_MODELO_CODEX=

# Login pela conta INEMA.PRO (para publicar a sala na internet, ex.: salaconf.inema.pro).
# Com SALA_LOGIN=inema, "/" vira a página de apresentação e só entra quem está na sala:
# o dono e a equipe pelos emails abaixo, convidados que o dono aceitou ou convidou (/convidar email).
# Só assinantes INEMA.PRO em dia (o inema.pro confere). Vazio = painel aberto, só nesta máquina.
# SALA_LOGIN=inema
# SALA_URL_PUBLICA=https://salaconf.inema.pro
# Email da conta INEMA.PRO de cada pessoa do perfil (perfil pessoa: email_env em perfis/pessoa.json).
SALA_DONO_EMAIL=
SALA_TIZA_EMAIL=
# Opcional: outro verificador (padrão https://www.inema.pro/api/assinatura?s=salaconf).
# SALA_VERIFICADOR_URL=
